# Copy to terraform.tfvars (gitignored) and fill in values.
# Prefer: $env:TF_VAR_jwt_secret = "..."

aws_region   = "us-east-1"
project_name = "springboot-api-template"
environment  = "dev"

# REQUIRED — ≥ 32 characters (or set TF_VAR_jwt_secret)
jwt_secret = "change-me-template-jwt-secret-key-32b!"

cors_allowed_origins = "https://localhost"
seed_demo_users      = false
allow_registration   = false

# Cost-friendly defaults
db_instance_class    = "db.t4g.micro"
db_multi_az          = false
create_ecs_service   = true
desired_count        = 1
task_cpu             = 256
task_memory          = 512
assign_public_ip     = true
image_tag            = "latest"
