# =============================================================================
# PROD runtime contract — inject these into ANY cloud container/task.
# Names are fixed. Do not rename for Azure/GCP; map secrets → these keys.
# Copy to a private store / CI variables. Never commit real values.
# =============================================================================

SPRING_PROFILES_ACTIVE=prod

# JDBC — host/port/db from your managed Postgres
DB_URL=jdbc:postgresql://REPLACE_HOST:5432/template
DB_USER=template
DB_PASSWORD=REPLACE_WITH_SECRET

# ≥ 32 characters
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Comma-separated browser origins (HTTPS in real deploys)
CORS_ALLOWED_ORIGINS=https://app.example.com

SEED_DEMO_USERS=false
ALLOW_REGISTRATION=false

# Optional
# JWT_EXPIRATION_MS=3600000
# JWT_REFRESH_EXPIRATION_MS=604800000
# RATE_LIMIT_LOGIN_PER_MIN=10
# RATE_LIMIT_API_PER_MIN=100
# AUTHZ_MODE=rbac
