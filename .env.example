# Copy to .env (never commit real secrets). Used with postgres / prod profiles.

# Spring profile: local | postgres | prod
# SPRING_PROFILES_ACTIVE=postgres

# PostgreSQL (profiles: postgres, prod)
# Host port 5433 maps to container 5432 (see docker-compose.yml) so local Postgres on 5432 does not conflict
DB_URL=jdbc:postgresql://localhost:5433/template
DB_USER=template
DB_PASSWORD=template

# JWT (required for prod; min 32 characters)
JWT_SECRET=change-me-template-jwt-secret-key-32b!
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Rate limits (prod)
# RATE_LIMIT_LOGIN_PER_MIN=10
# RATE_LIMIT_API_PER_MIN=100

# Production CORS (comma-separated origins; required for browsers with credentials)
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Identity (prod defaults: seed off, registration off)
# SEED_DEMO_USERS=false
# ALLOW_REGISTRATION=false
# Local demo users when seed enabled: admin/admin123, user/user123

# Authorization model: rbac (default) | abac  — both implementations included
# AUTHZ_MODE=rbac
# AUTHZ_MODE=abac

